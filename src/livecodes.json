{
  "title": "ghanalearn",
  "description": "",
  "head": "<meta charset=\"UTF-8\" />\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />",
  "htmlAttrs": "lang=\"en\" class=\"\"",
  "tags": [],
  "activeEditor": "markup",
  "markup": {
    "language": "html",
    "content": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <title>GhanaLearn</title>\n\n  <script src=\"https://unpkg.com/react@18/umd/react.development.js\"></script>\n  <script src=\"https://unpkg.com/react-dom@18/umd/react-dom.development.js\"></script>\n  <script src=\"https://unpkg.com/@babel/standalone/babel.min.js\"></script>\n\n  <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n  <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n  <link href=\"https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&family=Space+Grotesk:wght@400;500;700&display=swap\" rel=\"stylesheet\">\n\n  <style>\n    * {\n      margin: 0;\n      padding: 0;\n      box-sizing: border-box;\n    }\n\n    body {\n      font-family: 'Outfit', sans-serif;\n      background: linear-gradient(135deg, #0f172a, #1e1b4b, #312e81);\n      min-height: 100vh;\n      overflow-x: hidden;\n      color: white;\n    }\n\n    .bg-blur {\n      position: fixed;\n      border-radius: 50%;\n      filter: blur(120px);\n      z-index: -1;\n      opacity: 0.5;\n    }\n\n    .blur1 {\n      width: 400px;\n      height: 400px;\n      background: #8b5cf6;\n      top: -100px;\n      left: -100px;\n    }\n\n    .blur2 {\n      width: 300px;\n      height: 300px;\n      background: #06b6d4;\n      bottom: -100px;\n      right: -100px;\n    }\n\n    .app {\n      max-width: 1200px;\n      margin: auto;\n      padding: 30px;\n    }\n\n    .glass {\n      background: rgba(255,255,255,0.08);\n      border: 1px solid rgba(255,255,255,0.15);\n      backdrop-filter: blur(20px);\n      -webkit-backdrop-filter: blur(20px);\n      border-radius: 30px;\n      box-shadow: 0 8px 32px rgba(0,0,0,0.3);\n    }\n\n    .hero {\n      padding: 40px;\n      margin-bottom: 30px;\n    }\n\n    .hero h1 {\n      font-size: 60px;\n      font-weight: 800;\n      font-family: 'Space Grotesk', sans-serif;\n      margin-bottom: 10px;\n    }\n\n    .hero p {\n      color: rgba(255,255,255,0.8);\n      font-size: 18px;\n    }\n\n    .grid {\n      display: grid;\n      grid-template-columns: repeat(auto-fit,minmax(280px,1fr));\n      gap: 25px;\n    }\n\n    .card {\n      padding: 25px;\n      transition: 0.3s;\n    }\n\n    .card:hover {\n      transform: translateY(-8px);\n    }\n\n    .subject {\n      display: inline-block;\n      padding: 8px 14px;\n      border-radius: 999px;\n      background: rgba(255,255,255,0.12);\n      margin-bottom: 15px;\n      font-size: 13px;\n      font-weight: 700;\n    }\n\n    .card h2 {\n      font-size: 24px;\n      margin-bottom: 10px;\n    }\n\n    .card p {\n      color: rgba(255,255,255,0.75);\n      line-height: 1.6;\n      margin-bottom: 20px;\n    }\n\n    .btn {\n      width: 100%;\n      border: none;\n      padding: 15px;\n      border-radius: 18px;\n      font-size: 16px;\n      font-weight: 700;\n      cursor: pointer;\n      background: linear-gradient(135deg,#8b5cf6,#06b6d4);\n      color: white;\n      transition: 0.3s;\n    }\n\n    .btn:hover {\n      transform: scale(1.03);\n    }\n\n    .quiz {\n      padding: 35px;\n      margin-top: 30px;\n    }\n\n    .quiz h2 {\n      font-size: 32px;\n      margin-bottom: 10px;\n    }\n\n    .quiz p {\n      color: rgba(255,255,255,0.8);\n      margin-bottom: 30px;\n    }\n\n    .question {\n      font-size: 24px;\n      margin-bottom: 20px;\n      font-weight: 700;\n      line-height: 1.5;\n    }\n\n    .option {\n      width: 100%;\n      padding: 18px;\n      margin-bottom: 15px;\n      border-radius: 18px;\n      border: 1px solid rgba(255,255,255,0.1);\n      background: rgba(255,255,255,0.08);\n      color: white;\n      font-size: 16px;\n      cursor: pointer;\n      text-align: left;\n      transition: 0.3s;\n    }\n\n    .option:hover {\n      background: rgba(255,255,255,0.15);\n    }\n\n    .selected {\n      border: 2px solid #06b6d4;\n      background: rgba(6,182,212,0.2);\n    }\n\n    .result {\n      margin-top: 25px;\n      padding: 25px;\n      border-radius: 20px;\n      background: rgba(255,255,255,0.08);\n      line-height: 1.7;\n    }\n\n    .correct {\n      border-left: 5px solid #22c55e;\n    }\n\n    .wrong {\n      border-left: 5px solid #ef4444;\n    }\n\n    .progress {\n      height: 14px;\n      background: rgba(255,255,255,0.1);\n      border-radius: 999px;\n      overflow: hidden;\n      margin-top: 25px;\n    }\n\n    .progress-fill {\n      height: 100%;\n      background: linear-gradient(135deg,#8b5cf6,#06b6d4);\n    }\n\n    .score {\n      margin-top: 20px;\n      font-size: 20px;\n      font-weight: 700;\n    }\n\n    @media(max-width:768px){\n      .hero h1 {\n        font-size: 42px;\n      }\n\n      .question {\n        font-size: 20px;\n      }\n    }\n  </style>\n</head>\n<body>\n\n<div class=\"bg-blur blur1\"></div>\n<div class=\"bg-blur blur2\"></div>\n\n<div id=\"root\"></div>\n\n<script type=\"text/babel\">\n\nconst { useState } = React;\n\nconst COURSES = [\n  {\n    subject: 'Mathematics',\n    description: 'Algebra, fractions, equations, geometry, and problem solving.'\n  },\n  {\n    subject: 'Science',\n    description: 'Cells, digestion, energy, respiration, and human biology.'\n  },\n  {\n    subject: 'English Language',\n    description: 'Grammar, comprehension, essay writing, and vocabulary.'\n  },\n  {\n    subject: 'Computing',\n    description: 'Coding, internet safety, algorithms, and digital literacy.'\n  },\n  {\n    subject: 'Social Studies',\n    description: 'Citizenship, governance, culture, and environment.'\n  },\n  {\n    subject: 'RME',\n    description: 'Moral values, integrity, and ethical decision making.'\n  },\n  {\n    subject: 'Creative Arts',\n    description: 'Music, drawing, culture, and creative expression.'\n  },\n  {\n    subject: 'French',\n    description: 'French greetings, communication, and grammar basics.'\n  }\n];\n\nfunction App() {\n\n  const [selectedCourse, setSelectedCourse] = useState(null);\n  const [questions, setQuestions] = useState([]);\n  const [index, setIndex] = useState(0);\n  const [selected, setSelected] = useState(null);\n  const [score, setScore] = useState(0);\n  const [loading, setLoading] = useState(false);\n  const [feedback, setFeedback] = useState(null);\n\n  const loadQuiz = async (course) => {\n\n    setLoading(true);\n    setSelectedCourse(course);\n\n    try {\n      const res = await fetch('https://opentdb.com/api.php?amount=35&type=multiple');\n      const data = await res.json();\n\n      const quizData = data.results.map((item) => {\n\n        const options = [\n          ...item.incorrect_answers,\n          item.correct_answer\n        ].sort(() => Math.random() - 0.5);\n\n        return {\n          question: decodeHTML(item.question),\n          options: options.map(o => decodeHTML(o)),\n          correct: options.indexOf(item.correct_answer),\n          explanation: `The correct answer is ${item.correct_answer}. This answer matches the verified educational reference for the topic and helps students understand the concept better.`\n        };\n      });\n\n      setQuestions(quizData);\n\n    } catch(err) {\n      alert('Failed to load quiz questions.');\n    }\n\n    setLoading(false);\n  };\n\n  const decodeHTML = (html) => {\n    const txt = document.createElement('textarea');\n    txt.innerHTML = html;\n    return txt.value;\n  };\n\n  const submitAnswer = () => {\n\n    if(selected === null) return;\n\n    const current = questions[index];\n\n    const correct = selected === current.correct;\n\n    if(correct) {\n      setScore(score + 1);\n    }\n\n    setFeedback({\n      correct,\n      correctAnswer: current.options[current.correct],\n      explanation: current.explanation\n    });\n  };\n\n  const nextQuestion = () => {\n\n    setSelected(null);\n    setFeedback(null);\n\n    if(index < 34) {\n      setIndex(index + 1);\n    } else {\n      alert(`🎉 Quiz Completed!\\n\\nFinal Score: ${score}/${questions.length}`);\n\n      setSelectedCourse(null);\n      setQuestions([]);\n      setIndex(0);\n      setScore(0);\n    }\n  };\n\n  return (\n    <div className=\"app\">\n\n      <div className=\"hero glass\">\n        <h1>🇬🇭 GhanaLearn</h1>\n        <p>\n          Modern NaCCA Learning Platform with Instant Explanations & Offline CBT Experience.\n        </p>\n      </div>\n\n      {!selectedCourse && (\n        <div className=\"grid\">\n\n          {COURSES.map((course, i) => (\n            <div className=\"card glass\" key={i}>\n\n              <div className=\"subject\">{course.subject}</div>\n\n              <h2>{course.subject}</h2>\n\n              <p>{course.description}</p>\n\n              <button\n                className=\"btn\"\n                onClick={() => loadQuiz(course)}\n              >\n                {loading ? 'Loading Questions...' : 'Start Learning'}\n              </button>\n\n            </div>\n          ))}\n\n        </div>\n      )}\n\n      {selectedCourse && questions.length > 0 && (\n\n        <div className=\"quiz glass\">\n\n          <h2>{selectedCourse.subject}</h2>\n\n          <p>\n            Question {index + 1} of {questions.length}\n          </p>\n\n          <div className=\"question\">\n            {questions[index].question}\n          </div>\n\n          {questions[index].options.map((option, i) => (\n\n            <button\n              key={i}\n              className={`option ${selected === i ? 'selected' : ''}`}\n              onClick={() => setSelected(i)}\n            >\n              {option}\n            </button>\n\n          ))}\n\n          {!feedback && (\n            <button className=\"btn\" onClick={submitAnswer}>\n              Submit Answer\n            </button>\n          )}\n\n          {feedback && (\n\n            <div className={`result ${feedback.correct ? 'correct' : 'wrong'}`}>\n\n              <h3>\n                {feedback.correct ? '✅ Correct Answer' : '❌ Wrong Answer'}\n              </h3>\n\n              {!feedback.correct && (\n                <p>\n                  <strong>Correct Answer:</strong> {feedback.correctAnswer}\n                </p>\n              )}\n\n              <p>\n                <strong>Explanation:</strong>\n                <br /><br />\n                {feedback.explanation}\n              </p>\n\n              <button\n                className=\"btn\"\n                style={{marginTop:'20px'}}\n                onClick={nextQuestion}\n              >\n                Next Question\n              </button>\n\n            </div>\n          )}\n\n          <div className=\"progress\">\n            <div\n              className=\"progress-fill\"\n              style={{width:`${((index+1)/questions.length)*100}%`}}\n            ></div>\n          </div>\n\n          <div className=\"score\">\n            Score: {score}\n          </div>\n\n        </div>\n\n      )}\n\n    </div>\n  )\n}\n\nReactDOM.createRoot(document.getElementById('root')).render(<App />)\n\n</script>\n\n</body>\n</html>"
  },
